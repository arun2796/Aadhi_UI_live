# Production build configuration.
#
# The CI workflow (.github/workflows/deploy-pages.yml) writes .env.production.local from
# the GitHub repository variable VITE_API_BASE_URL, and that file OUTRANKS this one.
# This value is the fallback for a production build run by hand.
#
# Must be ABSOLUTE: the admin SPA is served by Cloudflare Pages while the API runs on AWS
# Lightsail, so a relative "/api/v1" would resolve to Pages itself. This origin must also
# appear in the API's Cors__AllowedOrigins.
VITE_API_BASE_URL=https://api.aadhicracker.in/api/v1
