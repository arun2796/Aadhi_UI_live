VITE_API_BASE_URL=/api/v1

# ── SEO build configuration ────────────────────────────────────────────────
# Public origin of the live storefront. Canonical URLs, og:url, sitemap.xml and
# the robots.txt Sitemap line are all built from it.
# Leave it blank ONLY if you are happy for the build to fall back to the domain
# of Store.Email from GET /settings/public; set it explicitly once the live
# domain is known (this can also be set as a Render environment variable).
VITE_SITE_URL=

# API base URL reachable from the BUILD MACHINE. VITE_API_BASE_URL above is the
# browser-relative "/api/v1" and cannot be fetched by Node, so the SEO build
# (sitemap.xml + prerendered product/category pages) needs the absolute URL here.
# Without it the build still succeeds but emits a CORE sitemap with no products.
VITE_SEO_API_BASE_URL=
