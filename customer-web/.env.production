# Production build configuration.
#
# The CI workflow (.github/workflows/deploy-pages.yml) writes .env.production.local
# from GitHub repository variables, and that file OUTRANKS this one. These values are
# the fallback for a production build run by hand.
#
# ── API ────────────────────────────────────────────────────────────────────
# Must be ABSOLUTE. The storefront is served by Cloudflare Pages and the API runs on
# AWS Lightsail — different origins — so a relative "/api/v1" would resolve to Pages
# itself and every request would 404. The API must list this site's origin in
# Cors__AllowedOrigins or the browser will block the calls.
VITE_API_BASE_URL=https://api.aadhicracker.in/api/v1

# ── SEO build configuration ────────────────────────────────────────────────
# Public origin of the live storefront. Canonical URLs, og:url, sitemap.xml and the
# robots.txt Sitemap line are all built from it. Leave blank only if you are happy for
# the build to fall back to the domain of Store.Email from GET /settings/public.
VITE_SITE_URL=https://aadhicracker.in

# API base URL reachable from the BUILD MACHINE. The SEO prebuild and prerender run in
# Node, which cannot fetch a browser-relative path, so they need the absolute URL here.
# Without it the build still succeeds but emits a CORE sitemap with no products and
# skips the per-page prerender.
VITE_SEO_API_BASE_URL=https://api.aadhicracker.in/api/v1
